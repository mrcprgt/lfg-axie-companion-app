<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvSlpTrackerLabel"
            style="@style/LFGPageHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="SLP Tracker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="16dp"
            android:background="@color/colorPrimary"
            android:src="@drawable/ic_baseline_more_vert_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDailyAverage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:textSize="36dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSlpTrackerLabel"
            tools:text="200" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDailyAverageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/white"
            android:textSize="18dp"
            app:layout_constraintStart_toStartOf="@id/tvDailyAverage"
            app:layout_constraintEnd_toEndOf="@id/tvDailyAverage"
            app:layout_constraintTop_toBottomOf="@id/tvDailyAverage"
            android:text="Daily" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWeeklyAverage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:textSize="36dp"
            app:layout_constraintEnd_toStartOf="@+id/tvMonthlyAverage"
            app:layout_constraintStart_toEndOf="@id/tvDailyAverage"
            app:layout_constraintTop_toBottomOf="@id/tvSlpTrackerLabel"
            tools:text="1400" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWeeklyAverageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/white"
            android:textSize="18dp"
            app:layout_constraintStart_toStartOf="@id/tvWeeklyAverage"
            app:layout_constraintEnd_toEndOf="@id/tvWeeklyAverage"
            app:layout_constraintTop_toBottomOf="@id/tvWeeklyAverage"
            android:text="Weekly" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMonthlyAverage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:textSize="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSlpTrackerLabel"
            tools:text="6000" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMonthlyAverageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/white"
            android:textSize="18dp"
            app:layout_constraintStart_toStartOf="@id/tvMonthlyAverage"
            app:layout_constraintEnd_toEndOf="@id/tvMonthlyAverage"
            app:layout_constraintTop_toBottomOf="@id/tvMonthlyAverage"
            android:text="Monthly" />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWeeklyAverageLabel"
            android:layout_marginTop="16dp"
            tools:listitem="@layout/slp_count_list_item"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>


