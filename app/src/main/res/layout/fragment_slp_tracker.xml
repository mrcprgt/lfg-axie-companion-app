<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvSlpTrackerLabel"
            style="@style/LFGPageHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="SLP Tracker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_baseline_cloud_upload_24"
            android:text="Check In"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMonthlyAverageLabel"
            app:layout_constraintStart_toEndOf="@id/ivSlp1"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDailyAverage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="10"
            android:textColor="@color/white"
            android:textSize="36dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSlpTrackerLabel"
            tools:text="12310" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDailyAverageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Daily"
            android:textColor="@color/white"
            android:textSize="18dp"
            app:layout_constraintEnd_toEndOf="@id/tvDailyAverage"
            app:layout_constraintStart_toStartOf="@id/tvDailyAverage"
            app:layout_constraintTop_toBottomOf="@id/tvDailyAverage" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWeeklyAverage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="10"
            android:textColor="@color/white"
            android:textSize="36dp"
            app:layout_constraintEnd_toStartOf="@+id/tvMonthlyAverage"
            app:layout_constraintStart_toEndOf="@id/tvDailyAverage"
            app:layout_constraintTop_toBottomOf="@id/tvSlpTrackerLabel"
            tools:text="0312312" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWeeklyAverageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Weekly"
            android:textColor="@color/white"
            android:textSize="18dp"
            app:layout_constraintEnd_toEndOf="@id/tvWeeklyAverage"
            app:layout_constraintStart_toStartOf="@id/tvWeeklyAverage"
            app:layout_constraintTop_toBottomOf="@id/tvWeeklyAverage" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMonthlyAverage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="10"
            android:textColor="@color/white"
            android:textSize="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSlpTrackerLabel"
            tools:text="4500" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMonthlyAverageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Monthly"
            android:textColor="@color/white"
            android:textSize="18dp"
            app:layout_constraintEnd_toEndOf="@id/tvMonthlyAverage"
            app:layout_constraintStart_toStartOf="@id/tvMonthlyAverage"
            app:layout_constraintTop_toBottomOf="@id/tvMonthlyAverage" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTotalManager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:textSize="18dp"
            app:layout_constraintTop_toBottomOf="@id/tvDailyAverageLabel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:text="Manager: 500" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTotalScholar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:textSize="18dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalManager"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:text="Scholar: 500" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivSlp1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/icon_slp___copy"
            app:layout_constraintBottom_toBottomOf="@+id/tvTotalManager"
            app:layout_constraintStart_toEndOf="@id/tvTotalManager"
            app:layout_constraintTop_toTopOf="@id/tvTotalManager" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivSlp2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/icon_slp___copy"
            app:layout_constraintBottom_toBottomOf="@+id/tvTotalScholar"
            app:layout_constraintStart_toEndOf="@id/tvTotalScholar"
            app:layout_constraintTop_toTopOf="@id/tvTotalScholar" />


        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTotalScholar"
            tools:listitem="@layout/slp_count_list_item" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>


