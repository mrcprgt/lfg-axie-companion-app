<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LFGAxieCompanionApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorSecondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.LFGAxieCompanionApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="ShapeableImageView.CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="LFGTextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">@color/white</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="maxLines">1</item>
        <item name="background">@drawable/rounded_edit_text</item>
    </style>

    <style name="LFGCardLabel">
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">24dp</item>
    </style>

    <style name="LFGPageHeader">
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">48dp</item>
    </style>

    <style name="LFGCardText">
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/poppins_light</item>
        <item name="android:textSize">16dp</item>
    </style>

    <style name="LFGCardValue">
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">16dp</item>
    </style>

    <style name="LFGProgressBar">
        <item name="color">@color/colorPrimary</item>
    </style>

    <style name="LFG.AlertDialog.Wrap" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="cornerFamily">rounded</item>
        <item name="dialogCornerRadius">8dp</item>
        <item name="textAppearanceButton">@style/LFGCardText</item>
        <item name="android:theme">@style/Theme.LFGAxieCompanionApp</item>
    </style>

    <style name="LFG.AlertDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="cornerFamily">rounded</item>
        <item name="dialogCornerRadius">8dp</item>
        <item name="textAppearanceButton">@style/LFGCardText</item>
        <item name="android:theme">@style/Theme.LFGAxieCompanionApp</item>
    </style>

    <style name="LFGTabText">
        <item name="fontFamily">@font/changa_one</item>
        <item name="android:textColor">@color/slp_label</item>
        <item name="android:textSize">12dp</item>
    </style>
</resources>